{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bait-and-switch-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "EDGEGAP_APP": "BaitAndSwitch",
    "EDGEGAP_VERSION": "prod"
  },
  "durable_objects": {
    "bindings": [{ "name": "SEA_LOBBY", "class_name": "SeaLobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeaLobby"] }]
}
